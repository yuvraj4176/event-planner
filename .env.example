# Copy this file to .env and fill in your key. The .env file is read when the server
# starts and is ignored by git. No variable is required: without a key the built-in
# planner is used for everything.

# Port and interface to listen on. The default host is loopback only.
PORT=3000
HOST=127.0.0.1

# Optional: enables AI ideas, AI answers and the floating chat assistant.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini models to try, in order. When one is out of quota, overloaded or
# retired, the next one is used automatically.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-pro

# Optional: host names the server answers to, separated by commas. The default is the
# local names (localhost, 127.0.0.1, [::1]) when listening only on this machine. Set it
# when you serve the site under a domain name.
# ALLOWED_HOSTS=planner.example.com

# Optional: set to true only when a trusted proxy (such as Vercel) sits in front of the server.
# The visitor's address is then read from the X-Forwarded-For header for rate limiting.
# TRUST_PROXY=false

# Optional tuning
AI_TIMEOUT_MS=20000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20
